# Environment variables template for FastAPI Application
# DO NOT store production passwords or secret keys in this file!
# Copy this file to .env for local development: cp .env.example .env

APP_NAME="FastAPI DevOps Service"
ENVIRONMENT="development"

# Database Configuration
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change_me_in_local_env"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="appdb"
